# Copy to .env (ignored by Git) or set these as real environment variables.

# Required: VIN of the vehicle your API key is bound to (17 characters).
SKODA_VIN=TMBXXXXXXXXXXXXXX
# Required: MyŠkoda Public API key (create it in the MyŠkoda app).
SKODA_API_KEY=replace-me

# Optional (defaults shown).
SKODA_PUBLIC_API_URL=https://public.api.connect.skoda-auto.cz
SKODA_CACHE_TTL=5m
