# Safe template for local secrets. Copy the values into .env; do not commit .env.
SKODA_EMAIL=your-myskoda-email@example.com
SKODA_PASSWORD=replace-with-your-myskoda-password
SKODA_VIN=replace-with-your-17-character-vin
SKODA_SPIN=replace-with-your-four-digit-s-pin
SKODA_GATEWAY_TOKEN=replace-with-a-long-random-gateway-token
